POSTGRES_PASSWORD=replace-with-a-long-random-value
CASDOOR_PUBLIC_URL=http://localhost:8000
# Create the Casdoor application first, then replace this with its Client ID.
# The same value is the expected access-token audience.
CASDOOR_CLIENT_ID=replace-with-casdoor-application-client-id
OXIDE_ADMIN_WEB_URL=http://localhost:1430
OXIDE_CONTROL_PLANE_PUBLIC_URL=http://localhost:8787
OXIDE_TICKET_SIGNING_KEY_BASE64=replace-with-32-random-bytes-in-base64
OXIDE_CONTROL_PLANE_VERIFYING_KEY_BASE64=replace-with-the-matching-ed25519-public-key
OXIDE_GATEWAY_ID=00000000-0000-0000-0000-000000000001
OXIDE_GATEWAY_DATA_SOURCE_URL=postgres://gateway-user:replace-me@database.internal/app
# Gateway enrollment is generated in the administration UI. Do not put its
# token or Ed25519 private key in this file; mount both as private files.
