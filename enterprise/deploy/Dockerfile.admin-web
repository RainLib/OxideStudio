FROM node:22-bookworm-slim AS build
WORKDIR /workspace
COPY package.json package-lock.json ./
COPY agent-contract ./agent-contract
COPY agent-host ./agent-host
COPY enterprise/admin-web ./enterprise/admin-web
RUN npm ci --ignore-scripts
ARG VITE_OXIDE_CONTROL_PLANE_URL
ARG VITE_OXIDE_OIDC_ISSUER
ARG VITE_OXIDE_OIDC_CLIENT_ID=oxide-enterprise-admin
RUN npm run enterprise:admin:build
COPY enterprise/deploy/nginx.conf /tmp/nginx.conf
RUN node --input-type=module -e "import fs from 'node:fs'; const values = [process.env.VITE_OXIDE_CONTROL_PLANE_URL, process.env.VITE_OXIDE_OIDC_ISSUER].filter(Boolean); const origins = [...new Set(values.map((value) => { const url = new URL(value); if (!['http:', 'https:'].includes(url.protocol)) throw new Error('admin web endpoints must use HTTP or HTTPS'); return url.origin; }))]; const template = fs.readFileSync('/tmp/nginx.conf', 'utf8'); fs.writeFileSync('/tmp/default.conf', template.replace('__OXIDE_ADMIN_CONNECT_SRC__', [\"'self'\", 'https:', ...origins.filter((origin) => origin.startsWith('http://'))].join(' '))); const config = {controlPlaneUrl: process.env.VITE_OXIDE_CONTROL_PLANE_URL || '', oidcIssuer: process.env.VITE_OXIDE_OIDC_ISSUER || '', oidcClientId: process.env.VITE_OXIDE_OIDC_CLIENT_ID || 'oxide-enterprise-admin'}; fs.writeFileSync('/tmp/config.js', 'window.__OXIDE_ENTERPRISE_CONFIG__ = ' + JSON.stringify(config) + ';\n');"

FROM nginx:1.27-alpine
COPY --from=build /tmp/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/enterprise/admin-web/dist /usr/share/nginx/html
COPY --from=build /tmp/config.js /usr/share/nginx/html/config.js
RUN chown -R 101:101 /var/cache/nginx /run /usr/share/nginx/html
USER 101:101
EXPOSE 8080
