FROM node:22-bookworm-slim AS build
WORKDIR /workspace
COPY package.json package-lock.json ./
COPY agent-contract ./agent-contract
COPY agent-host ./agent-host
COPY enterprise/admin-web ./enterprise/admin-web
RUN npm ci --ignore-scripts
ARG VITE_OXIDE_CONTROL_PLANE_URL
ARG VITE_OXIDE_OIDC_ISSUER
ARG VITE_OXIDE_OIDC_CLIENT_ID=oxide-enterprise-admin
RUN npm run enterprise:admin:build

FROM nginx:1.27-alpine
COPY enterprise/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/enterprise/admin-web/dist /usr/share/nginx/html
