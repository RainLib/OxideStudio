FROM rust:1.91.1-bookworm AS build
WORKDIR /workspace
COPY enterprise ./enterprise
COPY src-tauri ./src-tauri
RUN cargo build --manifest-path enterprise/Cargo.toml --release -p oxide-control-plane

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /workspace/enterprise/target/release/oxide-control-plane /usr/local/bin/
USER 65532:65532
ENTRYPOINT ["oxide-control-plane"]
