{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OxideStudio managed Java runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeKind",
    "javaMajor",
    "runtimeVersion",
    "entrypoint",
    "sha256",
    "supportedTargets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtimeKind": { "const": "java" },
    "javaMajor": { "const": 21 },
    "runtimeVersion": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$" },
    "entrypoint": {
      "type": "string",
      "maxLength": 240,
      "not": { "pattern": "(^/)|(^[A-Za-z]:)|(^|[\\/])\\.\\.([\\/]|$)" }
    },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "supportedTargets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._*-]{1,96}$" }
    }
  }
}
