{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxidestudio.local/schemas/database-driver-conformance-evidence-v1.json",
  "title": "OxideStudio Database Driver Conformance Evidence",
  "description": "Privacy-bounded output of the official runner. It intentionally contains no connection URL, credentials, SQL text or result values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runnerVersion", "passed", "startedAt", "completedAt", "target", "package", "fixture", "serverVersion", "operations", "privacy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runnerVersion": { "$ref": "#/$defs/token" },
    "passed": { "const": true },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "target": { "$ref": "#/$defs/token" },
    "serverVersion": { "type": "string", "minLength": 1, "maxLength": 96 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "packageVersion", "driverId", "protocolVersion", "manifestSha256", "entrypointSha256"],
      "properties": {
        "packageId": { "$ref": "#/$defs/token" },
        "packageVersion": { "$ref": "#/$defs/token" },
        "driverId": { "$ref": "#/$defs/token" },
        "protocolVersion": { "type": "string", "minLength": 1, "maxLength": 160 },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "entrypointSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": { "id": { "$ref": "#/$defs/token" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "operations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "status", "checks"],
        "properties": {
          "operation": { "$ref": "#/$defs/token" },
          "status": { "const": "passed" },
          "checks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsConnectionUrl", "containsCredentials", "containsStatements", "containsResultValues"],
      "properties": {
        "containsConnectionUrl": { "const": false },
        "containsCredentials": { "const": false },
        "containsStatements": { "const": false },
        "containsResultValues": { "const": false }
      }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
  }
}
