{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "OxideStudio",
    "version": "0.1.18",
    "identifier": "com.houshuai.oxide-studio",
    "build": {
        "features": ["desktop"],
        "beforeDevCommand": "npm run agent-host:build && node scripts/prepare-oxide-agent.mjs && node scripts/prepare-rocketmq-agent.mjs && node scripts/prepare-sql-lsp.mjs && npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build && node scripts/prepare-agent-host.mjs && node scripts/prepare-oxide-agent.mjs && node scripts/prepare-rocketmq-agent.mjs && node scripts/prepare-sql-lsp.mjs",
        "beforeBundleCommand": "node scripts/stage-bundled-cli.mjs",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "",
                "width": 1200,
                "height": 800,
                "minWidth": 1200,
                "minHeight": 800,
                "acceptFirstMouse": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
        },
        "macOSPrivateApi": true
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": false,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": {
            "binaries/sql-lsp": "sql-lsp",
            "binaries/sql-lsp.exe": "sql-lsp.exe",
            "binaries/sql-lsp.manifest.json": "sql-lsp.manifest.json",
            "binaries/sql-lsp.exe.manifest.json": "sql-lsp.exe.manifest.json",
            "../vendor/sql-lsp/UNICODE-LICENSE.txt": "sql-lsp.UNICODE-LICENSE.txt",
            "../vendor/sql-lsp/PINYIN-LICENSE.txt": "sql-lsp.PINYIN-LICENSE.txt"
        },
        "externalBin": [
            "binaries/oxide-agent-host",
            "binaries/oxide-agent",
            "binaries/oxide-agent-rocketmq"
        ]
    },
    "plugins": {
        "updater": {
            "endpoints": [],
            "pubkey": "",
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
