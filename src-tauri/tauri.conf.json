{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "OxideStudio",
    "version": "0.1.0",
    "identifier": "com.houshuai.oxide-studio",
    "build": {
        "beforeDevCommand": "OXIDE_SKIP_SQL_LSP_PREPARE=1 bash src-tauri/build_prepare.sh && npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build && bash src-tauri/build_prepare.sh",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "",
                "width": 1200,
                "height": 800,
                "minWidth": 1200,
                "minHeight": 800
            }
        ],
        "security": {
            "csp": null
        },
        "macOSPrivateApi": true
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": {
            "binaries/*": "."
        }
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/RainLib/OxideStudio/releases/latest/download/latest.json"
            ],
            "pubkey": "",
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
