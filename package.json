{
    "name": "oxide-studio",
    "private": true,
    "version": "0.1.16",
    "type": "module",
    "workspaces": [
        "agent-contract",
        "agent-host",
        "enterprise/admin-web"
    ],
    "scripts": {
        "dev": "node scripts/start-vite.mjs",
        "postinstall": "node scripts/patch-monaco-react.mjs",
        "build": "tsc && vite build && node scripts/verify-frontend-bundle.mjs",
        "verify:frontend-bundle": "node scripts/verify-frontend-bundle.mjs",
        "preview": "vite preview",
        "tauri": "tauri",
        "ai": "tsx scripts/oxide-ai.ts",
        "ai:mcp": "tsx scripts/oxide-ai.ts mcp stdio",
        "test": "vitest run",
        "test:release": "node --test scripts/*.node-test.mjs",
        "test:live-db": "bash scripts/test-live-databases.sh",
        "driver:conformance": "node scripts/run-driver-conformance.mjs",
        "benchmark:diagram": "tsx scripts/benchmark-schema-diagram.ts",
        "agent-host:build": "npm run build --workspace @oxide/agent-host",
        "agent-host:package": "npm run package --workspace @oxide/agent-host --",
        "oxide-agent:prepare": "node scripts/prepare-oxide-agent.mjs",
        "enterprise:admin:build": "npm run build --workspace @oxide/enterprise-admin",
        "enterprise:admin:dev": "npm run dev --workspace @oxide/enterprise-admin",
        "enterprise:deploy:verify": "node --env-file-if-exists=enterprise/deploy/.env scripts/verify-enterprise-deployment.mjs",
        "enterprise:target-binding": "node scripts/print-enterprise-target-binding.mjs",
        "test:agent-contract": "npm test --workspace @oxide/agent-contract",
        "test:agent-host": "npm test --workspace @oxide/agent-host"
    },
    "dependencies": {
        "@glideapps/glide-data-grid": "6.0.4-alpha24",
        "@langchain/core": "1.2.3",
        "@langchain/langgraph": "^1.4.7",
        "@monaco-editor/react": "4.7.0",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-context-menu": "^2.2.16",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-dialog": "^2.7.1",
        "@tauri-apps/plugin-opener": "^2.5.2",
        "@tauri-apps/plugin-process": "^2.3.1",
        "@tauri-apps/plugin-updater": "^2.10.1",
        "@types/lodash": "^4.17.21",
        "@types/marked": "^5.0.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "lodash": "^4.17.21",
        "lucide-react": "^0.562.0",
        "marked": "^16.0.10",
        "monaco-vim": "^0.4.4",
        "pinyin-pro": "^3.28.2",
        "react": "^19.2.3",
        "react-day-picker": "^9.13.0",
        "react-dom": "^19.2.3",
        "react-icons": "^5.7.0",
        "react-resizable-panels": "^4.2.1",
        "react-responsive-carousel": "^3.2.23",
        "tailwind-merge": "^3.4.0",
        "uuid": "^13.0.0",
        "zustand": "^5.0.9"
    },
    "overrides": {
        "@glideapps/glide-data-grid": {
            "react": "^19.0.0",
            "react-dom": "^19.0.0"
        }
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.18",
        "@tailwindcss/vite": "^4.1.18",
        "@tauri-apps/cli": "^2.11.4",
        "@types/node": "^25.0.3",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "autoprefixer": "^10.4.23",
        "happy-dom": "^20.10.6",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.18",
        "tsx": "^4.23.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.0",
        "vitest": "^4.1.9"
    }
}
