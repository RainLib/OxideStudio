{
  "schemaVersion": 1,
  "id": "clickhouse-core-v1",
  "driverId": "clickhouse",
  "connection": { "urlEnv": "OXIDE_CLICKHOUSE_CONFORMANCE_URL" },
  "serverVersionPattern": "^(2[3-9]|[3-9][0-9])\\.",
  "query": {
    "statement": "SELECT ? AS bound_number, ? AS bound_text",
    "parameters": [42, "oxide"],
    "context": { "readOnly": true },
    "expect": {
      "minResultSets": 1,
      "minRows": 1,
      "columns": ["bound_number", "bound_text"],
      "firstRow": [42, "oxide"]
    }
  },
  "databaseScope": {
    "statement": "SELECT currentDatabase() AS database_name",
    "context": { "database": "default", "readOnly": true },
    "expect": {
      "minRows": 1,
      "columns": ["database_name"],
      "firstRow": ["default"]
    }
  },
  "errorMapping": {
    "statement": "SELECT * FROM oxide_conformance_missing_table",
    "context": { "readOnly": true },
    "expectedCodes": ["QUERY_FAILED"]
  },
  "metadata": [
    {
      "id": "databases",
      "request": { "kind": "databases" },
      "expect": { "type": "array", "minItems": 1 }
    },
    {
      "id": "schemas",
      "request": { "kind": "schemas", "database": null },
      "expect": { "type": "array", "minItems": 1 }
    }
  ]
}
